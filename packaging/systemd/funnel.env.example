# Funnel system service configuration.
#
# Install this file as /etc/funnel/funnel.env, readable by the funnel group:
#   sudo install -o root -g funnel -m 0640 \
#     packaging/systemd/funnel.env.example /etc/funnel/funnel.env

# Public origin, for example https://funnel.example.com. Set it before
# onboarding; leave empty only for a direct local HTTP install.
FUNNEL_URL=

# Encryption secret used for sessions, GitHub App credentials, and OAuth
# tokens. Required, at least 32 characters. Generate one with:
#   openssl rand -base64 32
# Keep it stable and back it up separately from the database.
FUNNEL_SECRET=

# Data directory for the SQLite database and uploads.
FUNNEL_DATA_DIR=/var/lib/funnel

# Environment file loaded by the packaged executable.
FUNNEL_ENV_FILE=/etc/funnel/funnel.env

# Optional overrides.
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info
# TZ=UTC
