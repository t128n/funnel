<?xml version="1.0" encoding="utf-8"?>
<!--
  WinSW service definition for Funnel.

  This is a template: `install-service.ps1` substitutes the %%TOKENS%% with the
  paths/values it was given and writes the result next to the WinSW executable
  as `funnel-service.xml`. WinSW requires the config file to share the
  executable's base name, which is why the binary is installed as
  `funnel-service.exe`.

  Documentation: https://github.com/winsw/winsw/blob/v2/docs/xml-config-file.md
-->
<service>
  <id>funnel</id>
  <name>Funnel</name>
  <description>Funnel — GitHub issue triage server.</description>

  <executable>%%EXE_PATH%%</executable>
  <!-- The data directory is also the working directory, so Bun autoloads the
       .env placed there (secrets, FUNNEL_URL, …). -->
  <workingdirectory>%%DATA_DIR%%</workingdirectory>

  <!-- Overridable variables. Everything can also live in the .env file. -->
  <env name="FUNNEL_DATA_DIR" value="%%DATA_DIR%%" />
  <env name="PORT" value="%%PORT%%" />
  <env name="HOST" value="0.0.0.0" />
  <env name="LOG_LEVEL" value="%%LOG_LEVEL%%" />
  <!-- Must be >= FUNNEL_UPLOAD_MAX_BYTES for the issue dropbox. -->
  <env name="BODY_SIZE_LIMIT" value="25M" />

  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <!-- adapter-node's default graceful-shutdown window is 30s. -->
  <stoptimeout>35 sec</stoptimeout>

  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
</service>
