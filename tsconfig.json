{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"types": ["bun-types", "node", "$app/types"],
		"paths": {
			"#/*": ["./src/*"],
			"#lib/*": ["./src/lib/*"],
			"#tests/*": ["./tests/*"]
		}
	},
	"include": ["src", "vite.config.ts"],
	"exclude": [
		"build",
		"dist",
		"node_modules",
		".svelte-kit",
		"src/standalone-entry.ts"
	]
}
