{
	"name": "funnel",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"start": "bun ./build/index.js",
		"prepare": "bun --bun svelte-kit sync || echo ''",
		"check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "bun --bun drizzle-kit push",
		"db:generate": "bun --bun drizzle-kit generate",
		"db:migrate": "bun --bun drizzle-kit migrate",
		"db:studio": "bun --bun drizzle-kit studio",
		"test": "bun test --preload ./tests/setup.ts --max-concurrency 1 --coverage src tests"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.59.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.3",
		"@types/sanitize-html": "^2.16.2",
		"@valibot/to-json-schema": "^1.8.0",
		"bun-types": "^1.4.3",
		"cn": "^0.5.0",
		"drizzle-kit": "^1.0.0-rc.4",
		"pino-pretty": "^13.2.0",
		"shadcn-svelte": "^1.7.0",
		"shiki": "^3.20.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"yaml": "^2.9.1"
	},
	"imports": {
		"#/*": "./src/*",
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#tests/*": "./tests/*"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "^1.7.7",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@openfeature/server-sdk": "^1.23.0",
		"@tanstack/hotkeys": "0.16.0",
		"@tanstack/svelte-hotkeys": "^0.15.0",
		"@types/node": "^26.6.5",
		"better-auth": "^1.7.7",
		"bits-ui": "^2.19.5",
		"c12": "^4.0.0-rc.2",
		"drizzle-orm": "^1.0.0-rc.4",
		"lowlight": "^3.3.0",
		"lru-cache": "^11.5.3",
		"octokit": "^5.0.5",
		"pele": "^1.6.0",
		"pino": "^10.4.0",
		"sanitize-html": "^2.18.1",
		"satteri": "^0.10.5",
		"svelte-dnd-action": "^0.9.80",
		"svelte-sonner": "^1.2.1",
		"valibot": "^1.5.0"
	}
}
