{
	"name": "funnel",
	"private": true,
	"version": "0.0.12",
	"type": "module",
	"packageManager": "bun@1.4.3",
	"engines": {
		"bun": ">=1.4.3"
	},
	"scripts": {
		"dev": "bun --bun vite dev",
		"dev:demo": "bun scripts/dev.ts --demo",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"start": "bun ./build/index.js",
		"release": "bun scripts/release.ts",
		"build:standalone": "bun scripts/build-standalone.ts",
		"package:release": "bun scripts/package-release.ts",
		"fetch-winsw": "bun scripts/fetch-winsw.ts",
		"changeset": "changeset",
		"changeset:status": "changeset status",
		"changeset:check": "bun scripts/check-changesets.ts",
		"changeset:version": "changeset version",
		"prepare": "bun --bun svelte-kit sync || echo ''",
		"check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "bun --bun drizzle-kit push",
		"db:generate": "bun --bun drizzle-kit generate",
		"db:migrate": "bun --bun drizzle-kit migrate",
		"db:studio": "bun --bun drizzle-kit studio",
		"test": "bun test --preload ./tests/setup.ts --max-concurrency 1 --coverage src tests && bun scripts/check-coverage.ts"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/bun": "^1.4.3",
		"@types/node": "^26.6.5",
		"@types/sanitize-html": "^2.16.2",
		"@valibot/to-json-schema": "^1.8.0",
		"bun-types": "^1.4.3",
		"drizzle-kit": "^1.0.0-rc.4",
		"pino-pretty": "^13.2.0",
		"playwright": "^1.64.1",
		"shiki": "^3.20.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"yaml": "^2.9.1"
	},
	"imports": {
		"#/*": "./src/*",
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#tests/*": "./tests/*"
	},
	"dependencies": {
		"@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
		"@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.2.1",
		"@better-auth/drizzle-adapter": "^1.7.7",
		"@bomb.sh/args": "^0.3.1",
		"@clack/prompts": "^1.8.1",
		"@sveltestrap/sveltestrap": "^7.1.0",
		"@tanstack/hotkeys": "0.16.0",
		"@tanstack/svelte-hotkeys": "^0.15.0",
		"better-auth": "^1.7.7",
		"bootstrap": "^5.3.8",
		"bootstrap-icons": "^1.13.2",
		"dotenv": "^18.0.9",
		"drizzle-orm": "^1.0.0-rc.4",
		"echarts": "^5.6.0",
		"forges": "0.2.0",
		"lat.md": "^0.13.3",
		"lowlight": "^3.3.0",
		"lru-cache": "^11.5.3",
		"pele": "^1.6.0",
		"pino": "^10.4.0",
		"sanitize-html": "^2.18.1",
		"satteri": "^0.10.5",
		"svelte-echarts": "^1.0.0",
		"valibot": "^1.5.0",
		"virtua": "^0.53.5"
	}
}
