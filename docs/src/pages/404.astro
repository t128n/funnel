---
const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Page not found | Funnel</title>
  </head>
  <body>
    <main>
      <h1>Page not found</h1>
      <p>Check the address or return to the <a href={home}>Funnel documentation</a>.</p>
    </main>
  </body>
</html>
