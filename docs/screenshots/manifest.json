  {
    "id": "matrix",
    "guides": [
      "docs/how-to/use/matrix.md"
    ],
    "steps": [
      {
        "action": "open",
        "path": "/matrix"
      },
      {
        "action": "wait",
        "selector": "[data-testid=\"matrix-grid\"]"
      },
      {
        "action": "capture",
        "file": "matrix/01-open-matrix.png",
        "state": "Priority matrix"
      },
      {
        "action": "click-text-until",
        "text": "Rating Guide",
        "selector": ".modal"
      },
      {
        "action": "wait",
        "selector": ".modal"
      },
      {
        "action": "wait-fn",
        "value": "(() => { const e = document.querySelector(\".modal\"); return e && getComputedStyle(e).display !== \"none\" && Number(getComputedStyle(e).opacity) > 0.99; })()"
      },
      {
        "action": "capture",
        "file": "matrix/02-open-guide.png",
        "state": "Rating Guide dialog"
      }
    ]
  },
  {
    "id": "plan",
    "guides": [
      "docs/how-to/use/plan-work.md",
      "docs/tutorials/plan-and-track-a-cycle.md"
    ],
    "steps": [
      {
        "action": "open",
        "path": "/issues/demo/funnel/4"
      },
      {
        "action": "wait",
        "selector": "#issue-size"
      },
      {
        "action": "select",
        "selector": "#issue-size",
        "value": "sm"
      },
      {
        "action": "wait-fn",
        "value": "(() => {const e = document.querySelector(\"#issue-size\"); return e && !e.disabled && e.value === \"sm\";})()"
      },
      {
        "action": "open",
        "path": "/plan"
      },
      {
        "action": "wait",
        "selector": "table tbody tr"
      },
      {
        "action": "wait-text",
        "text": "Cockpit time panel double-counts review time in the actual total"
      },
      {
        "action": "wait-fn",
        "value": "!document.body.innerText.includes(\"No sized issues are scheduled to a maintainer this week.\")"
      },
      {
        "action": "capture",
        "file": "plan/01-open-plan.png",
        "state": "Current week plan with a sized scheduled issue"
      }
    ]
  },
