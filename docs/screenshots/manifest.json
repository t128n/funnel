  {
    "id": "timeline",
    "guides": [
      "docs/how-to/use/milestones.md"
    ],
    "steps": [
      {
        "action": "open",
        "path": "/timeline"
      },
      {
        "action": "wait",
        "selector": "[data-testid=\"timeline-chart\"]"
      },
      {
        "action": "wait-fn",
        "value": "(() => { const c = document.querySelector(\"[data-testid=timeline-chart] canvas\"); if (!c || !c.width || !c.height) return false; const d = c.getContext(\"2d\").getImageData(0, 0, c.width, c.height).data; let n = 0; for (let i = 3; i < d.length; i += 4) if (d[i] && ++n > 1000) return true; return false; })()"
      },
      {
        "action": "capture",
        "file": "timeline/01-open-timeline.png",
        "state": "Milestone timeline"
      }
    ]
  },
