      },
      {
        "action": "wait",
        "selector": "form"
      },
      {
        "action": "capture",
        "file": "intake/01-open-intake.png",
        "state": "Public intake form"
      },
      {
        "action": "fill",
        "selector": "[name=\"title\"]",
        "value": "Export CSV fails when the filter is empty"
      },
      {
        "action": "fill",
        "selector": "[name=\"body\"]",
        "value": "Filtering before export produces an empty file."
      },
      {
        "action": "capture",
        "file": "intake/02-fill-draft.png",
        "state": "Intake draft with fictional report"
      }
    ]
  },
