[
  {
    "id": "triage-intake",
    "guides": [
      "docs/how-to/use/triage-intake.md",
      "docs/tutorials/triage-a-backlog.md"
    ],
    "steps": [
      {
        "action": "open",
        "path": "/inbox"
      },
      {
        "action": "wait",
        "selector": "table tbody tr"
      },
      {
        "action": "capture",
        "file": "triage-intake/01-open-triage-intake.png",
        "state": "Seeded Inbox queue"
      },
      {
        "action": "click-expanded",
        "selector": "button[aria-label='Snooze submission Link intake submissions to existing issues']"
      },
      {
        "action": "wait-text",
        "text": "Tomorrow"
      },
      {
        "action": "capture",
        "file": "triage-intake/02-snooze-menu.png",
        "state": "Snooze menu"
      },
      {
        "action": "click-text",
        "text": "Tomorrow"
      },
      {
        "action": "open",
        "path": "/inbox?snoozed=1"
      },
      {
        "action": "wait-text",
        "text": "Link intake submissions to existing issues"
      },
      {
        "action": "wait-text",
        "text": "Resurface"
      },
      {
        "action": "capture",
        "file": "triage-intake/03-snooze-snoozed.png",
        "state": "Snoozed queue"
      }
    ]
  },
  {
    "id": "intake",
    "guides": [
      "docs/tutorials/triage-a-backlog.md"
