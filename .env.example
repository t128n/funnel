# Public URL where the instance is hosted (Optional in local dev)
# Example: https://funnel.example.com
FUNNEL_URL=

# 32-byte encryption secret (Required, min 32 chars)
# Generate (OpenSSL): openssl rand -base64 32
# Generate (Node.js): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FUNNEL_SECRET=

# Path to the SQLite database file (Optional, default: ./data/funnel.db)
# FUNNEL_DB=./data/funnel.db

# GitHub host. Defaults target github.com. For GitHub Enterprise Server set both
# (e.g. FUNNEL_GITHUB_URL=https://acme.ghe.com, FUNNEL_GITHUB_API_URL=https://acme.ghe.com/api/v3).
# FUNNEL_GITHUB_URL=https://github.com
# FUNNEL_GITHUB_API_URL=https://api.github.com

# Default issue-comment rendering: compact (dense list) or bubbles (chat-style).
# Browsers can override this per browser in Settings > Features. (Default: compact)
# FUNNEL_COMMENT_UI=compact


# Numeric App ID found in the "About" section (e.g., 123456)
GITHUB_APP_ID=

# OAuth Client ID starting with "Iv1." or "Iv23."
GITHUB_CLIENT_ID=

# OAuth Client Secret (40+ characters, generated under "Client secrets")
GITHUB_CLIENT_SECRET=

# PEM-encoded RSA Private Key (generated on Credentials > Key pair page)
# Format single-line for .env: awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private-key.pem
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
...
-----END RSA PRIVATE KEY-----"

# Options: fatal | error | warn | info | debug | trace | silent (Default: info)
LOG_LEVEL=info
